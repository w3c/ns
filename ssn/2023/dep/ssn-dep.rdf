        <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
        <owl:onProperty>
          <rdf:Description rdf:nodeID="cb102e040ae6dbcbf51648c0e9d3700c6f0529d2b35b85521bf466d9ed4fea6310e">
