          </rdf:Description>
        </owl:onProperty>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="cb1e3d512647d73d0cc6a4beca58dab0077fe632c19952b2b9daa2869ffc2811639">
        <owl:allValuesFrom rdf:resource="http://www.w3.org/ns/sosa/Procedure"/>
        <owl:onProperty>
          <rdf:Description rdf:nodeID="cbd4116988f4f7cde247072250d544da03faf5e12d5fbe5e1bd5f6de53cdf5ac69">
            <owl:inverseOf rdf:resource="http://www.w3.org/ns/ssn/hasOutput"/>
          </rdf:Description>
        </owl:onProperty>
