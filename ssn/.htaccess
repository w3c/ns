######################################################################
# Rewrite rules for the SSN namespace, https://www.w3.org/ns/ssn/
#
# Ontologies and rules developed by the Spatial Data on the Web WG.
#
# Two editions are served, 2017 and 2023.
#
# An ontology IRI — this namespace, one of its modules, one of its
# terms — serves the most recent edition that has it.  A version IRI,
# .../ssn/2017/... or .../ssn/2023/..., serves that edition and
# keeps serving it.  Every redirect here is temporary: a later edition
# may well revive a module or a term that 2023 dropped, and a 301 kept
# in a client's cache would hide that.
#
# Anything under this namespace that is neither a file, a directory,
# nor one of the names below is not part of it, and gets the 404 that
# Apache returns when no rule and no file matches.
#
# The block between the two markers is generated from the ontologies
# themselves by ssn/scripts/publish_namespace.py, in w3c/sdw-sosa-ssn.
# Everything outside the markers is written by hand.
######################################################################

RewriteEngine On

######################################################################
# Get rid of any query string: none of the IRIs served here has one.
# The rewrite is internal, so the rules below see a clean path.
######################################################################
RewriteCond  %{QUERY_STRING}  !=""
RewriteRule  ^(.*)$  $1?

######################################################################
# The graphs this namespace served from here until now are the graphs
# of the 2017 edition.  Their URLs keep working: the request goes to
# the same file under that edition, where the rules of the edition
# answer it.  A file no edition has still ends in a 404.
######################################################################
RewriteRule  ^(.+)\.(ttl|rdf|jsonld|nt|html)$  /ns/ssn/2017/$1.$2  [R=303,L]

# BEGIN generated term rules — ssn/scripts/publish_namespace.py
# 10 module(s) and 53 term(s) of /ns/ssn/,
# written from the ontologies and from the anchors of the
# specification.  Do not edit by hand.

# The IRI of this namespace serves its most recent edition (2023).

RewriteRule  ^$  /ns/ssn/2023/  [R=303,L]

# Each module of this namespace serves the most recent edition
# that has it.

RewriteRule  ^act/?$  /ns/ssn/2023/act/  [R=303,L]
RewriteRule  ^common/?$  /ns/ssn/2023/common/  [R=303,L]
RewriteRule  ^dep/?$  /ns/ssn/2023/dep/  [R=303,L]
RewriteRule  ^dul/?$  /ns/ssn/2017/dul  [R=303,L]
RewriteRule  ^ext/?$  /ns/ssn/2017/ext  [R=303,L]
RewriteRule  ^obs/?$  /ns/ssn/2023/obs/  [R=303,L]
RewriteRule  ^oms/?$  /ns/ssn/2023/oms/  [R=303,L]
RewriteRule  ^sam/?$  /ns/ssn/2023/sam/  [R=303,L]
RewriteRule  ^systems/?$  /ns/ssn/2017/systems/  [R=303,L]

# A client that wants HTML goes to the anchor where the edition
# that defines the term defines it.

RewriteCond  %{HTTP_ACCEPT}  text/html [NC]
RewriteRule  ^(Deployment|Input|Output|Property|Stimulus|System|deployedOnPlatform|deployedSystem|detects|forProperty|hasDeployment|hasInput|hasOutput|hasProperty|hasSubSystem|implementedBy|implements|inDeployment|isPropertyOf|isProxyFor|wasOriginatedBy)$  https://www.w3.org/TR/vocab-ssn/#SSN$1  [R=303,NE,L]

RewriteCond  %{HTTP_ACCEPT}  text/html [NC]
RewriteRule  ^systems/(Accuracy|ActuationRange|BatteryLifetime|Condition|DetectionLimit|Drift|Frequency|Latency|MaintenanceSchedule|MeasurementRange|OperatingPowerRange|OperatingProperty|OperatingRange|Precision|Resolution|ResponseTime|Selectivity|Sensitivity|SurvivalProperty|SurvivalRange|SystemCapability|SystemLifetime|SystemProperty|hasOperatingProperty|hasOperatingRange|hasSurvivalProperty|hasSurvivalRange|hasSystemCapability|hasSystemProperty|inCondition|qualityOfObservation)$  https://www.w3.org/TR/vocab-ssn/#SSNSYSTEM$1  [R=303,NE,L]

# Deprecated terms have no anchor of their own.
RewriteCond  %{HTTP_ACCEPT}  text/html [NC]
RewriteRule  ^(deployedAsset)$  https://www.w3.org/TR/vocab-ssn-2023/  [R=303,L]

# Every other client goes to the module that defines the term.

RewriteRule  ^(Deployment|Input|Output|Property|Stimulus|System|deployedAsset|deployedOnPlatform|deployedSystem|detects|forProperty|hasDeployment|hasInput|hasOutput|hasProperty|hasSubSystem|implementedBy|implements|inDeployment|isPropertyOf|isProxyFor|wasOriginatedBy)$  /ns/ssn/2023/dep/  [R=303,L]

RewriteRule  ^systems/(Accuracy|ActuationRange|BatteryLifetime|Condition|DetectionLimit|Drift|Frequency|Latency|MaintenanceSchedule|MeasurementRange|OperatingPowerRange|OperatingProperty|OperatingRange|Precision|Resolution|ResponseTime|Selectivity|Sensitivity|SurvivalProperty|SurvivalRange|SystemCapability|SystemLifetime|SystemProperty|hasOperatingProperty|hasOperatingRange|hasSurvivalProperty|hasSurvivalRange|hasSystemCapability|hasSystemProperty|inCondition|qualityOfObservation)$  /ns/ssn/2017/systems/  [R=303,L]

# END generated term rules
