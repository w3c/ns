      "@id": "shexTest:startColumn",
      "@type": "xsd:integer"
    },
    "startRow": {
      "@id": "shexTest:startRow",
      "@type": "xsd:integer"
    },
    "trait": {
      "@id": "shexTest:trait",
      "@language": null
