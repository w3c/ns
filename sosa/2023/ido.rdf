    <rdfs:comment xml:lang="en"><![CDATA[Alignment of the the W3C/OGC SOSA Ontology with the Industrial Data Ontology (IDO) version 4.0 <http://rds.posccaesar.org/ontology/lis14/ont/core/4.0>]]></rdfs:comment>
    <rdfs:label xml:lang="en">Alignment of SOSA with IDO</rdfs:label>
    <owl:imports rdf:resource="http://rds.posccaesar.org/ontology/lis14/ont/core/"/>
    <owl:imports rdf:resource="http://www.w3.org/ns/sosa/"/>
    <owl:versionIRI rdf:resource="http://www.w3.org/ns/sosa/2023/ido"/>
    <skos:note xml:lang="en">A caution is advised if using the provided alignment with IDO major versions higher than 4.0</skos:note>
    <dcat:hasCurrentVersion rdf:resource="http://www.w3.org/ns/sosa/2023/ido"/>
    <dcat:hasVersion rdf:resource="http://www.w3.org/ns/sosa/2023/ido"/>
    <dcat:version>2023</dcat:version>
  </owl:Ontology>
