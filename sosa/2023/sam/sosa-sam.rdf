  <owl:Class rdf:about="http://www.w3.org/ns/sosa/MaterialSample">
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/sam/"/>
    <rdfs:label xml:lang="en">Material Sample</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/Sample"/>
    <skos:definition xml:lang="en">
  subset of a FeatureOfInterest that is physical (i.e., tangible)
  </skos:definition>
    <skos:example xml:lang="en">A piece of rock, a blood sample, a water sample, etc.</skos:example>
    <skos:note xml:lang="en">MaterialSamples may be destroyed in connexion with the observation act or a subsequent preparation step.</skos:note>
    <skos:note xml:lang="en">MaterialSamples that are curated and preserved are sometimes known as 'specimens'.</skos:note>
  </owl:Class>
