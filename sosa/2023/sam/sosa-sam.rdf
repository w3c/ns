  <owl:Class rdf:about="http://www.w3.org/ns/sosa/StatisticalSample">
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/sam/"/>
    <rdfs:label xml:lang="en">Statistical Sample</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/Sample"/>
    <skos:definition xml:lang="en">
  subset of a FeatureOfInterest defined by the statistical process used to create it
  </skos:definition>
    <skos:example xml:lang="en">The male or female subset of a population.</skos:example>
    <skos:note xml:lang="en">StatisticalSamples usually apply to populations or other sets, of which a certain subset may be of specific interest.</skos:note>
  </owl:Class>
