    <rdfs:comment xml:lang="en">Alignment of the W3C/OGC SOSA/SSN ontology with the DOLCE ontology in OWL, in particular with the DOLCEbasic module. This file includes bridge axioms between SOSA 2017 and SOSA/SSN 2023, to be removed later.</rdfs:comment>
    <rdfs:label xml:lang="en">Alignment of SOSA with DOLCE in OWL</rdfs:label>
    <owl:imports rdf:resource="http://www.w3.org/ns/sosa/"/>
    <owl:imports rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic"/>
    <owl:versionIRI rdf:resource="http://www.w3.org/ns/sosa/2023/dolce"/>
    <owl:versionInfo rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.9</owl:versionInfo>
    <dcat:hasCurrentVersion rdf:resource="http://www.w3.org/ns/sosa/2023/dolce"/>
    <dcat:hasVersion rdf:resource="http://www.w3.org/ns/sosa/2023/dolce"/>
    <dcat:version>2023</dcat:version>
  </owl:Ontology>
