<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
  xmlns:owl="http://www.w3.org/2002/07/owl#"
  xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
  xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
  xmlns:dcat="http://www.w3.org/ns/dcat#"
  xmlns:foaf="http://xmlns.com/foaf/0.1/"
  xmlns:dcterms="http://purl.org/dc/terms/"
>
  <rdf:Description rdf:about="http://www.w3.org/ns/sosa/Observation">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Activity"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/sosa/isResultOf">
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#wasGeneratedBy"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/sosa/Sample">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
  </rdf:Description>
  <owl:Ontology rdf:about="http://www.w3.org/ns/sosa/prov">
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2016-12-14</dcterms:created>
    <dcterms:creator>Simon J D Cox</dcterms:creator>
    <dcterms:creator>
      <foaf:Agent rdf:nodeID="cbf5d73687b92314be8bba6303d69683c397e714c4b07497180520c0ae053783f3">
        <foaf:name xml:lang="en">W3C/OGC Spatial Data on the Web Working Group</foaf:name>
      </foaf:Agent>
    </dcterms:creator>
    <dcterms:license rdf:resource="http://www.opengeospatial.org/ogc/Software"/>
    <dcterms:license rdf:resource="http://www.w3.org/Consortium/Legal/2015/copyright-software-and-document"/>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-02-22</dcterms:modified>
    <dcterms:rights>Copyright 2017, 2026 W3C/OGC.</dcterms:rights>
    <rdfs:comment xml:lang="en">Alignment of the the W3C/OGC SOSA Ontology with the W3C PROV-O Ontology</rdfs:comment>
    <rdfs:label xml:lang="en">Alignment of SOSA with PROV-O</rdfs:label>
    <owl:imports rdf:resource="http://www.w3.org/ns/prov-o#"/>
    <owl:imports rdf:resource="http://www.w3.org/ns/sosa/"/>
    <owl:priorVersion rdf:resource="http://www.w3.org/ns/sosa/2017/prov"/>
    <owl:versionIRI rdf:resource="http://www.w3.org/ns/sosa/2023/prov"/>
    <dcat:hasCurrentVersion rdf:resource="http://www.w3.org/ns/sosa/2023/prov"/>
    <dcat:hasVersion rdf:resource="http://www.w3.org/ns/sosa/2017/prov"/>
    <dcat:hasVersion rdf:resource="http://www.w3.org/ns/sosa/2023/prov"/>
    <dcat:previousVersion rdf:resource="http://www.w3.org/ns/sosa/2017/prov"/>
    <dcat:version>2023</dcat:version>
  </owl:Ontology>
  <rdf:Description rdf:about="http://www.w3.org/ns/sosa/Property">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/sosa/madeBySystem">
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#wasAssociatedWith"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/sosa/System">
    <rdfs:subClassOf>
      <owl:Class rdf:nodeID="cb16075a02f14fd7eee930a657e72ae1cee118c2f2b6c3777283b155dfaf0dd2111">
        <owl:unionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="http://www.w3.org/ns/prov#Agent"/>
          <rdf:Description rdf:about="http://www.w3.org/ns/prov#Entity"/>
        </owl:unionOf>
      </owl:Class>
    </rdfs:subClassOf>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/sosa/endTime">
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#endedAtTime"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/sosa/hasResult">
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#generated"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/sosa/FeatureOfInterest">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/sosa/Asset">
    <rdfs:subClassOf>
      <owl:Class rdf:nodeID="cb83e85fe14e3732913d842c437d4acb1f945b7e8c0d5b6c22da15251c136b29c4">
        <owl:unionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="http://www.w3.org/ns/prov#Agent"/>
          <rdf:Description rdf:about="http://www.w3.org/ns/prov#Entity"/>
        </owl:unionOf>
      </owl:Class>
    </rdfs:subClassOf>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/sosa/Actuation">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Activity"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/sosa/isSampleOf">
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#wasDerivedFrom"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/sosa/startTime">
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#startedAtTime"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/sosa/Platform">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/sosa/usedProcedure">
    <owl:propertyChainAxiom rdf:parseType="Collection">
      <rdf:Description rdf:about="http://www.w3.org/ns/sosa/prov/executionAssociation"/>
      <rdf:Description rdf:about="http://www.w3.org/ns/sosa/prov/hadProcedure"/>
    </owl:propertyChainAxiom>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/sosa/Sampling">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Activity"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/sosa/Deployment">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Activity"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/sosa/hasFeatureOfInterest">
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#used"/>
  </rdf:Description>
  <owl:ObjectProperty rdf:about="http://www.w3.org/ns/sosa/prov/hadProcedure">
    <rdfs:range>
      <rdf:Description rdf:about="http://www.w3.org/ns/sosa/Procedure">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Plan"/>
      </rdf:Description>
    </rdfs:range>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#hadPlan"/>
  </owl:ObjectProperty>
  <rdf:Description rdf:about="http://www.w3.org/ns/sosa/Execution">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Activity"/>
  </rdf:Description>
  <owl:ObjectProperty rdf:about="http://www.w3.org/ns/sosa/prov/executionAssociation">
    <rdfs:domain rdf:resource="http://www.w3.org/ns/sosa/Execution"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#qualifiedAssociation"/>
  </owl:ObjectProperty>
</rdf:RDF>
