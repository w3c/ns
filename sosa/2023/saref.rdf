  <rdf:Description rdf:about="https://saref.etsi.org/core/State">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/sosa/hasUltimateFeatureOfInterest">
