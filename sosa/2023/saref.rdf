  xmlns:dcat="http://www.w3.org/ns/dcat#"
  xmlns:owl="http://www.w3.org/2002/07/owl#"
  xmlns:foaf="http://xmlns.com/foaf/0.1/"
  xmlns:dcterms="http://purl.org/dc/terms/"
>
  <rdf:Description rdf:about="http://www.w3.org/ns/sosa/actsOnProperty">
    <rdfs:subPropertyOf rdf:resource="https://saref.etsi.org/core/controls"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/sosa/actsOn">
    <rdfs:subPropertyOf rdf:resource="https://saref.etsi.org/core/controls"/>
  </rdf:Description>
  <owl:Ontology rdf:about="http://www.w3.org/ns/sosa/saref">
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-03-14</dcterms:created>
    <dcterms:creator>Maxime Lefrançois</dcterms:creator>
    <dcterms:creator>
      <foaf:Agent rdf:nodeID="cbad0869f1606d3cef7a225a3a40f4958ca55d97176d40854b5345e58accc817bb">
        <foaf:name xml:lang="en">W3C/OGC Spatial Data on the Web Working Group</foaf:name>
      </foaf:Agent>
    </dcterms:creator>
    <dcterms:license rdf:resource="http://www.opengeospatial.org/ogc/Software"/>
    <dcterms:license rdf:resource="http://www.w3.org/Consortium/Legal/2015/copyright-software-and-document"/>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-03-14</dcterms:modified>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-02-19</dcterms:modified>
    <dcterms:rights>Copyright 2025 W3C/OGC.</dcterms:rights>
    <rdfs:comment xml:lang="en">Alignment of the the W3C/OGC SOSA Ontology with the ETSI Smart Applications REFerence Ontology (SAREF).</rdfs:comment>
    <rdfs:label xml:lang="en">Alignment of SOSA with SAREF Core V4.1.1</rdfs:label>
    <owl:imports rdf:resource="http://www.w3.org/ns/sosa/"/>
    <owl:imports rdf:resource="https://saref.etsi.org/core/v4.1.1"/>
    <owl:imports rdf:resource="https://saref.etsi.org/saref4syst/v1.1.2"/>
    <owl:versionIRI rdf:resource="http://www.w3.org/ns/sosa/2023/saref"/>
    <dcat:hasCurrentVersion rdf:resource="http://www.w3.org/ns/sosa/2023/saref"/>
    <dcat:hasVersion rdf:resource="http://www.w3.org/ns/sosa/2023/saref"/>
    <dcat:version>2023</dcat:version>
  </owl:Ontology>
  <rdf:Description rdf:about="https://saref.etsi.org/core/hasStateOfInterest">
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/sosa/hasProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/sosa/MaterialSample">
    <rdfs:subClassOf rdf:resource="https://saref.etsi.org/core/FeatureOfInterest"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/sosa/hasSample">
    <rdfs:subPropertyOf rdf:resource="https://saref.etsi.org/saref4syst/hasSubSystem"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/sosa/hasResult">
    <owl:equivalentProperty rdf:resource="https://saref.etsi.org/core/hasResult"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/sosa/startTime">
    <owl:equivalentProperty rdf:resource="https://saref.etsi.org/core/hasStartTime"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/sosa/Sampling">
    <rdfs:subClassOf>
      <rdf:Description rdf:about="https://saref.etsi.org/core/ProcedureExecution">
        <owl:equivalentClass rdf:resource="http://www.w3.org/ns/sosa/Execution"/>
      </rdf:Description>
    </rdfs:subClassOf>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/sosa/StatisticalSample">
    <rdfs:subClassOf rdf:resource="https://saref.etsi.org/core/FeatureOfInterest"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/sosa/phenomenonTime">
    <owl:equivalentProperty rdf:resource="https://saref.etsi.org/core/hasPhenomenonTime"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/sosa/usedProcedure">
    <owl:equivalentProperty rdf:resource="https://saref.etsi.org/core/isExecutionOf"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/sosa/hasSubSystem">
    <rdfs:subPropertyOf rdf:resource="https://saref.etsi.org/core/consistsOf"/>
    <rdfs:subPropertyOf rdf:resource="https://saref.etsi.org/saref4syst/hasSubSystem"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/core/Device">
