  <rdf:Description rdf:about="http://www.w3.org/ns/sosa/propertyFor">
    <rdfs:subPropertyOf rdf:resource="https://saref.etsi.org/core/isActedUponBy"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/sosa/madeBySampler">
