        <rdfs:subClassOf rdf:resource="https://saref.etsi.org/saref4syst/System"/>
      </rdf:Description>
    </rdfs:subClassOf>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/sosa/madeBySensor">
    <rdfs:subPropertyOf rdf:resource="https://saref.etsi.org/core/madeBy"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/core/Operation">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/Procedure"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/sosa/hasOriginalSample">
    <rdfs:subPropertyOf rdf:resource="https://saref.etsi.org/saref4syst/hasSubSystem"/>
