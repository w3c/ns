  <rdf:Description rdf:about="http://www.w3.org/ns/sosa/FeatureOfInterest">
    <rdfs:subClassOf rdf:resource="https://saref.etsi.org/core/FeatureOfInterest"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/core/Sensor">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/Sensor"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/sosa/Platform">
    <rdfs:subClassOf rdf:resource="https://saref.etsi.org/saref4syst/System"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/core/Command">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/Procedure"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/core/Actuator">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/Actuator"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/core/Property">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/sosa/Observation">
    <owl:equivalentClass rdf:resource="https://saref.etsi.org/core/Observation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/core/CommandOfInterest">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/Procedure"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/core/StateOfInterest">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/sosa/hasFeatureOfInterest">
