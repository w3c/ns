  <rdf:Description rdf:about="http://www.w3.org/ns/sosa/resultTime">
    <owl:equivalentProperty rdf:resource="https://saref.etsi.org/core/hasResultTime"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/sosa/implements">
    <owl:propertyChainAxiom rdf:parseType="Collection">
      <rdf:Description rdf:about="https://saref.etsi.org/core/hasFunction"/>
      <rdf:Description rdf:about="https://saref.etsi.org/core/hasCommand"/>
    </owl:propertyChainAxiom>
    <owl:propertyChainAxiom rdf:parseType="Collection">
      <rdf:Description rdf:about="https://saref.etsi.org/core/offers"/>
      <rdf:Description rdf:about="https://saref.etsi.org/core/hasOperation"/>
    </owl:propertyChainAxiom>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/core/PropertyOfInterest">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/Property"/>
