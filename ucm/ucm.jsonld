        "@value": "2025-01-01"
      },
      "dcterms:creator": {
        "@id": "https://www.w3.org/community/ucm/"
      },
      "dcterms:description": {
        "@language": "en",
        "@value": "UCM is an RDF vocabulary providing a common semantic foundation for achieving semantic interoperability across healthcare and human-service ecosystems. It serves as a semantic bridge that enables standards, ontologies, information models, and data models developed by independent communities to communicate with a shared understanding of information while preserving their respective semantics."
      },
